# =============================================================================
# Conveyor Belt Monitoring System — Environment Variables Template
#
# Copy this file to .env and fill in your real credentials.
# NEVER commit the actual .env file — it is listed in .gitignore.
# =============================================================================

# ── Twilio SMS Alerts ────────────────────────────────────────────────────────
# Get these from https://console.twilio.com/
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_FROM_NUMBER=+1xxxxxxxxxx

# ── Alert Recipients ─────────────────────────────────────────────────────────
# Comma-separated phone numbers in E.164 format (+country code)
ALERT_ADMIN_PHONES=+91xxxxxxxxxx
ALERT_MAINTENANCE_PHONES=+91xxxxxxxxxx

# ── Conveyor Identity ─────────────────────────────────────────────────────────
CONVEYOR_ID=CV-IRON-01
